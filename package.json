{
  "name": "@dddx/monorepo",
  "private": true,
  "scripts": {
    "dddx": "bun --hot run ./packages/cli/src/cli.ts",
    "dddx:prod": "./packages/cli/bin/dddx.mjs",
    "build": "turbo run build",
    "publish": "turbo run publish",
    "publish:web": "bun run --cwd apps/web publish",
    "build:caps": "bun run --cwd packages/cli build:caps",
    "build:plugins": "bun run --cwd packages/plugins-official build",
    "publish:plugins": "bun run --cwd packages/plugins-official publish",
    "clean": "bun run scripts/clean.ts",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "bun run --workspaces typecheck"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "prettier": "^3.7.4",
    "turbo": "^2.9.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "latest",
      "@tsconfig/bun": "1.0.10",
      "nanoid": "latest",
      "zod": "latest",
      "typescript": "5.9.2"
    }
  },
  "patchedDependencies": {
    "agentation@3.0.2": "patches/agentation@3.0.2.patch"
  },
  "dddx": {
    "apps": {
      "apps/web": {
        "port": "3000"
      }
    }
  }
}
